{
  "name": "@harmoniclabs/mithril-ts",
  "version": "0.1.0",
  "description": "Mithril in pure TypeScript: certificate chains, cardano-database, stake distribution and transaction proofs, snapshot download, production and serving. Browsers, Bun and Node.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && bun test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "author": "Harmonic Laboratories",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarmonicLabs/mithril-ts.git"
  },
  "bugs": {
    "url": "https://github.com/HarmonicLabs/mithril-ts/issues"
  },
  "homepage": "https://github.com/HarmonicLabs/mithril-ts#readme",
  "dependencies": {
    "@harmoniclabs/crypto": "^0.3.1"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "keywords": ["cardano", "mithril", "stm", "bls12-381", "certificate", "snapshot"]
}
